{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt && python -c \"import nltk; nltk.download('stopwords', quiet=True); nltk.download('punkt', quiet=True)\""
  },
  "deploy": {
    "startCommand": "cd dashboard && gunicorn app:app --bind 0.0.0.0:$PORT --workers 2 --threads 4 --timeout 120",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE"
  },
  "environments": {
    "production": {
      "variables": {
        "PORT": "5000",
        "HOST": "0.0.0.0",
        "LOG_LEVEL": "INFO",
        "USE_LLM_FALLBACK": "true"
      }
    }
  }
}
